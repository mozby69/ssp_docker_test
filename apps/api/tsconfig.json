{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node",
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "target": "ES2020",
    "strict": true,
    "noEmit": false,
  },
  "include": [
    "src",
    "generated"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "prisma.config.ts"
  ]
}